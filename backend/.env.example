# Qingnang backend - environment template
# Copy to .env and fill in real values (never commit .env).
DEBUG=false
SECRET_KEY=please-generate-64-char-random-hex
DATABASE_URL=postgresql+psycopg2://qingnang:CHANGE_ME@localhost:5432/qingnang
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTO_SEED=false

# 运行环境：development（默认）/ production（生产不注入 dev 账号）
APP_ENV=development

# ══════════════════════════════════════════════
# LLM（全局只用 DeepSeek 云端，必填）
# ══════════════════════════════════════════════
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 青檬引擎（仅用于确定性推理：八字推演 / 生活提醒 / 体质向量计算）
# 不再承担 LLM 能力
QINGMENG_URL=http://localhost:8000
