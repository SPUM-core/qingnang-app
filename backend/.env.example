# Qingnang backend - environment template
# Copy to .env and fill in real values (never commit .env).
DEBUG=false
SECRET_KEY=please-generate-64-char-random-hex
DATABASE_URL=postgresql+psycopg2://qingnang:CHANGE_ME@localhost:5432/qingnang
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTO_SEED=false

# 运行环境：development（默认）/ production（生产不注入 dev 账号）
APP_ENV=development

# ══════════════════════════════════════════════
# AI 模型配置（用户可在设置页面选择 provider）
# ══════════════════════════════════════════════
# Provider 1: SPUM 本地模型（青檬引擎 — 默认）
# 通过本地 qingmeng-engine 调用 Ollama /v1/chat/completions
# 不需要 API KEY，但需要 qingmeng-engine 在 localhost:8000 运行
# QINGMENG_URL=http://localhost:8000
# QINGMENG_MODEL=spum-coder:latest

# Provider 2: DeepSeek（云端）
# 用户选择后直接走官方 API，不经过青檬引擎
# 必须填 API KEY，BASE_URL 和 MODEL 一般不需要改
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
