# Qingnang backend - environment template
# Copy to .env and fill in real values (never commit .env).
DEBUG=false
SECRET_KEY=please-generate-64-char-random-hex
DATABASE_URL=postgresql+psycopg2://qingnang:CHANGE_ME@localhost:5432/qingnang
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTO_SEED=false

# 运行环境：development（默认）/ production（生产不注入 dev 账号）
APP_ENV=development
