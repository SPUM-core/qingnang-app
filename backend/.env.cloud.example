# ═══════════════════════════════════════════════════════════
# 青囊 APP · Cloud Studio 免费试用环境变量
# 放在 backend/.env.cloud
# 用 source .env.cloud 或启动脚本会自动读取
# ═══════════════════════════════════════════════════════════

# 开发期：CORS 自动放行 cloudstudio.work 域名 + cpolar/ngrok
APP_ENV=development
DEBUG=true

# SQLite（Cloud Studio 没有 PostgreSQL）
DATABASE_URL=sqlite:///./qingnang.db

# JWT — 随便一串随机就行（临时 Demo 用）
SECRET_KEY=qingnang-demo-secret-key-cloudstudio-2026-temporary-only

# AI：用 DeepSeek 云端（替代本地 Ollama，Cloud Studio 跑不动 Ollama）
# 👉 把下面换成你自己的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-请换成你自己的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 青檬引擎关闭（Cloud Studio 没 GPU 跑不动）
# QINGMENG_URL 保持默认即可，但 LLM provider 强制走 deepseek

# 种子数据：关闭（SQLite 会自动 create_all，空表即可）
AUTO_SEED=false
